{
  "plugin_id": "system",
  "version": "0.1.0",
  "permissions": [
    "PERMISSION_SYSTEM"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "system",
  "events": [],
  "files": [
    "system",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "sys_info",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": [
              "string",
              "null"
            ]
          },
          "os": {
            "type": [
              "string",
              "null"
            ],
            "description": "Long OS name, e.g. 'Arch Linux'."
          },
          "os_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "kernel": {
            "type": [
              "string",
              "null"
            ]
          },
          "arch": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "x86_64",
              "aarch64",
              "x86",
              "arm"
            ]
          }
        },
        "required": [
          "hostname",
          "os",
          "os_version",
          "kernel",
          "arch"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_battery",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "number"
          },
          "state": {
            "type": "string",
            "enum": [
              "unknown",
              "charging",
              "discharging",
              "empty",
              "full"
            ]
          },
          "time_to_empty_s": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "time_to_full_s": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "percent",
          "state",
          "time_to_empty_s",
          "time_to_full_s"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_procs",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "process_count": {
            "type": "integer",
            "minimum": 0
          },
          "load_avg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "1/5/15-minute load averages."
          },
          "memory_total_mb": {
            "type": "integer",
            "minimum": 0
          },
          "memory_used_mb": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "process_count",
          "load_avg",
          "memory_total_mb",
          "memory_used_mb"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_volume",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "percent",
          "muted"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "sys_volume_set",
      "input": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "percent",
          "muted"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_volume_mute",
      "input": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "toggle"
            ],
            "description": "Explicit target state; 'toggle' flips the current one."
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer"
          },
          "muted": {
            "type": "boolean"
          }
        },
        "required": [
          "percent",
          "muted"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_brightness",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_brightness_set",
      "input": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "0 clamps to the device's minimum non-blanking step."
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_lock",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_power_profile",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "available": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "profile",
          "available"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "sys_power_profile_set",
      "input": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "performance",
              "balanced",
              "power-saver"
            ]
          }
        },
        "required": [
          "profile"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "available": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "profile",
          "available"
        ],
        "additionalProperties": true
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {},
    "additionalProperties": true
  }
}
