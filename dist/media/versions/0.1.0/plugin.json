{
  "plugin_id": "media",
  "version": "0.1.0",
  "permissions": [],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "media",
  "events": [],
  "files": [
    "media",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "media_play",
      "input": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name (org.mpris.MediaPlayer2.<name>); omit for the default player."
          },
          "uri": {
            "type": "string",
            "description": "Optional media URI to open before playing."
          }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_pause",
      "input": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_play_pause",
      "input": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "playing": {
            "type": "boolean",
            "description": "Playback state after the toggle."
          }
        },
        "required": [
          "ok",
          "playing"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_next",
      "input": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_prev",
      "input": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_stop",
      "input": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_seek",
      "input": {
        "type": "object",
        "properties": {
          "position_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Absolute seek target in milliseconds from the start of the track."
          },
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "required": [
          "position_ms"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "position_ms": {
            "type": "integer",
            "description": "Resulting position in milliseconds."
          }
        },
        "required": [
          "position_ms"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_seek_relative",
      "input": {
        "type": "object",
        "properties": {
          "offset_ms": {
            "type": "integer",
            "description": "Signed offset in milliseconds from the current position (negative seeks backward; result clamps at 0)."
          },
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "required": [
          "offset_ms"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "position_ms": {
            "type": "integer",
            "description": "Requested target position in milliseconds after applying the offset."
          }
        },
        "required": [
          "position_ms"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_volume",
      "input": {
        "type": "object",
        "properties": {
          "level": {
            "description": "Target volume: a 0.0..1.0 fraction or a 0..100 integer percentage.",
            "type": [
              "number",
              "integer"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "required": [
          "level"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "volume": {
            "type": "number",
            "description": "Resulting volume as a 0.0..1.0 fraction."
          }
        },
        "required": [
          "volume"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_status",
      "input": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "player": {
            "type": "string",
            "description": "MPRIS player name queried."
          },
          "status": {
            "type": "string",
            "enum": [
              "Playing",
              "Paused",
              "Stopped"
            ]
          },
          "metadata": {
            "type": "object",
            "description": "Normalized MPRIS metadata (title, artists, album, length_micros, track_id, art_url).",
            "additionalProperties": true
          },
          "volume": {
            "type": "number",
            "description": "Volume as a 0.0..1.0 fraction."
          },
          "position_ms": {
            "type": "integer",
            "description": "Current playback position in milliseconds."
          },
          "rate": {
            "type": "number",
            "description": "Playback rate (1.0 normal, 0.0 paused)."
          },
          "shuffle": {
            "type": "boolean",
            "description": "Shuffle enabled."
          },
          "loop_status": {
            "type": "string",
            "enum": [
              "None",
              "Track",
              "Playlist"
            ],
            "description": "Loop mode."
          }
        },
        "required": [
          "player",
          "status",
          "metadata",
          "volume",
          "position_ms",
          "rate",
          "shuffle",
          "loop_status"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_list_players",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "players": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "MPRIS player names (org.mpris.MediaPlayer2.<name>) available on the session bus."
          }
        },
        "required": [
          "players"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_shuffle",
      "input": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Enable shuffle (true) or disable (false). Alias `shuffle` also accepted."
          },
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "required": [
          "enabled"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "shuffle": {
            "type": "boolean"
          }
        },
        "required": [
          "shuffle"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "media_loop",
      "input": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "none",
              "track",
              "playlist",
              "None",
              "Track",
              "Playlist"
            ],
            "description": "Loop mode: none / track (single) / playlist (all)."
          },
          "player": {
            "type": "string",
            "description": "MPRIS player name; omit for the default player."
          }
        },
        "required": [
          "mode"
        ],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "loop_status": {
            "type": "string",
            "enum": [
              "None",
              "Track",
              "Playlist"
            ]
          }
        },
        "required": [
          "loop_status"
        ],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "MEDIA_PLUGIN_PLAYERS": {
        "type": "string",
        "description": "Allowlist mode (default allow-all): comma-separated MPRIS player names (org.mpris.MediaPlayer2.<name>) this plugin may control."
      },
      "MEDIA_PLUGIN_DEFAULT_PLAYER": {
        "type": "string",
        "description": "MPRIS player name used when a request omits `player`. Unset = first available player."
      }
    },
    "additionalProperties": true
  }
}
