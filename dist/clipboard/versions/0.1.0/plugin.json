{
  "plugin_id": "clipboard",
  "version": "0.1.0",
  "permissions": ["clipboard"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "clipboard",
  "events": [],
  "files": ["clipboard", "plugin.json"],
  "actions": [
    {
      "name": "clipboard_read",
      "permission": "clipboard",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": { "type": "boolean", "description": "False when the clipboard is empty." },
          "text": { "type": ["string", "null"], "description": "Clipboard text (UTF-8); null when not found." },
          "provider": { "type": "string", "description": "Backend binary used (wl-paste / xclip / xsel)." }
        },
        "required": ["found", "text", "provider"],
        "additionalProperties": false
      }
    },
    {
      "name": "clipboard_write",
      "permission": "clipboard",
      "input": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "minLength": 1, "description": "Text to place on the clipboard (UTF-8, size-capped). Empty writes are rejected to avoid accidental clears." }
        },
        "required": ["text"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "provider": { "type": "string", "description": "Backend binary used (wl-copy / xclip / xsel)." },
          "bytes": { "type": "integer", "description": "UTF-8 byte length written." }
        },
        "required": ["ok", "provider", "bytes"],
        "additionalProperties": false
      }
    },
    {
      "name": "clipboard_providers",
      "permission": "clipboard",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "session": { "type": "string", "enum": ["wayland", "x11"], "description": "Detected graphical session." },
          "readers": { "type": "array", "items": { "type": "string" }, "description": "Reader binaries tried in order." },
          "writers": { "type": "array", "items": { "type": "string" }, "description": "Writer binaries tried in order." }
        },
        "required": ["session", "readers", "writers"],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "CLIPBOARD_PLUGIN_PROVIDER": {
        "type": "string",
        "enum": ["auto", "wayland", "x11"],
        "description": "Provider preference; auto detects from WAYLAND_DISPLAY/XDG_SESSION_TYPE/DISPLAY."
      },
      "CLIPBOARD_PLUGIN_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 1,
        "description": "Per-spawn timeout in milliseconds (default 5000)."
      },
      "CLIPBOARD_PLUGIN_MAX_BYTES": {
        "type": "integer",
        "minimum": 1,
        "description": "Hard cap on clipboard payload size in bytes (default 1048576)."
      }
    },
    "additionalProperties": true
  }
}
