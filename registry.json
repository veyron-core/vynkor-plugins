  "mic": {
    "name": "Mic",
    "description": "Microphone capture primitive for vynkor plugins \u2014 the single owner of the mic. `mic_start` spawns a well-known host recorder binary directly with argv (never a shell), reads raw PCM from its stdout in a background task, and streams it out as `AudioStreamChunk` envelopes (codec `PCM_S16LE`) to the requested peer \u2014 D-12 machinery, `tts_speak` in reverse. `mic_stop` ends a session (idempotent), `mic_status` reports what is capturing. Declares `PERMISSION_AUDIO`, `PERMISSION_AUDIO_STREAM`, and `PERMISSION_IPC_SEND`.",
    "category": "utility",
    "tags": [
      "stable"
    ],
    "status": "",
