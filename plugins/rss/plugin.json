{
  "plugin_id": "rss",
  "version": "0.1.0",
  "permissions": ["PERMISSION_STORAGE", "PERMISSION_NETWORK"],
  "kernel_compatibility_range": { "min": "0.1.0", "max": "*" },
  "binary": "rss",
  "events": [],
  "files": ["rss", "plugin.json"],
  "actions": [
    {
      "name": "rss_add",
      "permission": "PERMISSION_STORAGE",
      "input": { "type": "object", "properties": { "url": { "type": "string" } }, "required": ["url"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "id": { "type": "string" }, "feed": { "$ref": "#/$defs/feed" } }, "required": ["id", "feed"], "additionalProperties": false }
    },
    {
      "name": "rss_remove",
      "permission": "PERMISSION_STORAGE",
      "input": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 } }, "required": ["id"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "removed": { "type": "boolean" } }, "required": ["removed"], "additionalProperties": false }
    },
    {
      "name": "rss_list",
      "input": { "type": "object", "properties": {}, "additionalProperties": false },
      "output": { "type": "object", "properties": { "feeds": { "type": "array", "items": { "$ref": "#/$defs/feed" } } }, "required": ["feeds"], "additionalProperties": false }
    },
    {
      "name": "rss_fetch",
      "permission": "PERMISSION_NETWORK",
      "input": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 }, "timeout_ms": { "type": "integer", "minimum": 1, "default": 10000 } }, "required": ["id"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "fetched": { "type": "integer" }, "new": { "type": "integer" } }, "required": ["fetched", "new"], "additionalProperties": false }
    },
    {
      "name": "rss_fetch_all",
      "permission": "PERMISSION_NETWORK",
      "input": { "type": "object", "properties": { "timeout_ms": { "type": "integer", "minimum": 1, "default": 10000 } }, "additionalProperties": false },
      "output": { "type": "object", "properties": { "fetched": { "type": "integer" }, "new": { "type": "integer" }, "feeds": { "type": "integer" } }, "required": ["fetched", "new", "feeds"], "additionalProperties": false }
    },
    {
      "name": "rss_articles",
      "input": { "type": "object", "properties": { "feed_id": { "type": "string" }, "unread_only": { "type": "boolean", "default": false }, "query": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 }, "offset": { "type": "integer", "minimum": 0, "default": 0 } }, "additionalProperties": false },
      "output": { "type": "object", "properties": { "articles": { "type": "array", "items": { "$ref": "#/$defs/article" } }, "total": { "type": "integer" } }, "required": ["articles", "total"], "additionalProperties": false }
    },
    {
      "name": "rss_mark_read",
      "permission": "PERMISSION_STORAGE",
      "input": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1 }, "read": { "type": "boolean", "default": true } }, "required": ["id"], "additionalProperties": false },
      "output": { "type": "object", "properties": { "updated": { "type": "boolean" }, "article": { "$ref": "#/$defs/article" } }, "required": ["updated"], "additionalProperties": false }
    },
    {
      "name": "status",
      "input": { "type": "object", "properties": {}, "additionalProperties": false },
      "output": { "type": "object", "properties": { "version": { "type": "string" }, "uptime_ms": { "type": "integer" }, "engine_ready": { "type": "boolean" }, "last_error": { "type": ["string", "null"] }, "counters": { "type": "object" } }, "required": ["version", "uptime_ms", "engine_ready"], "additionalProperties": true }
    }
  ],
  "$defs": {
    "feed": { "type": "object", "properties": { "id": { "type": "string" }, "url": { "type": "string" }, "title": { "type": "string" }, "created_at_ms": { "type": "integer" } }, "required": ["id", "url", "title", "created_at_ms"], "additionalProperties": false },
    "article": { "type": "object", "properties": { "id": { "type": "string" }, "feed_id": { "type": "string" }, "title": { "type": "string" }, "link": { "type": "string" }, "published_ms": { "type": ["integer", "null"] }, "read": { "type": "boolean" }, "created_at_ms": { "type": "integer" } }, "required": ["id", "feed_id", "title", "link", "read", "created_at_ms"], "additionalProperties": false }
  },
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "RSS_PLUGIN_DB_TIMEOUT_MS": { "type": "integer", "minimum": 1, "default": 5000 },
      "RSS_PLUGIN_FETCH_TIMEOUT_MS": { "type": "integer", "minimum": 1, "default": 10000 }
    },
    "additionalProperties": true
  }
}
