{
  "plugin_id": "calendar",
  "version": "0.1.1",
  "permissions": [
    "PERMISSION_STORAGE",
    "PERMISSION_EVENT_PUBLISH",
    "PERMISSION_NOTIFY"
  ],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "calendar",
  "events": [],
  "files": [
    "calendar",
    "plugin.json"
  ],
  "actions": [
    {
      "name": "event_create",
      "input": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 512,
            "description": "Event title. Required, non-empty."
          },
          "description": {
            "type": "string",
            "maxLength": 4096,
            "description": "Optional longer text."
          },
          "start_ms": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Start time, unix milliseconds (UTC). Required."
          },
          "end_ms": {
            "type": "integer",
            "description": "End time, unix milliseconds. Optional; must be >= start_ms."
          },
          "all_day": {
            "type": "boolean",
            "default": false,
            "description": "Metadata flag for date-only events; clients interpret display."
          },
          "remind_before_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 315360000000,
            "description": "Fire a reminder this many ms before start_ms (0 = exactly at start). Absent = no reminder."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "description": "Tags: trimmed, empties dropped, deduplicated, each ≤64 bytes. Optional."
          }
        },
        "required": [
          "title",
          "start_ms"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Assigned event id (monotonic counter)."
          },
          "event": {
            "$ref": "#/$defs/event"
          }
        },
        "required": [
          "id",
          "event"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "event_get",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean"
          },
          "event": {
            "$ref": "#/$defs/event"
          }
        },
        "required": [
          "found"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "event_list",
      "input": {
        "type": "object",
        "properties": {
          "from_ms": {
            "type": "integer",
            "description": "Only events with start_ms >= this. Optional."
          },
          "to_ms": {
            "type": "integer",
            "description": "Only events with start_ms <= this. Optional."
          },
          "tag": {
            "type": "string",
            "description": "Only events carrying this tag. Optional."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Page size."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Skip this many events after filtering/sorting."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/event"
            },
            "description": "Sorted by start_ms ascending (id ascending tie-break)."
          },
          "total": {
            "type": "integer",
            "description": "Count after filtering, before pagination."
          }
        },
        "required": [
          "events",
          "total"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "event_update",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 512,
            "description": "Replaces the title when present."
          },
          "description": {
            "type": "string",
            "maxLength": 4096,
            "description": "Replaces the description when present."
          },
          "start_ms": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Replaces the start when present; resets reminder_fired."
          },
          "end_ms": {
            "type": "integer",
            "description": "Replaces the end when present; resets reminder_fired. Must be >= resulting start_ms."
          },
          "all_day": {
            "type": "boolean",
            "description": "Replaces the flag when present."
          },
          "remind_before_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 315360000000,
            "description": "Replaces the reminder lead when present; resets reminder_fired."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "description": "Replaces the whole tag set when present."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "updated": {
            "type": "boolean"
          },
          "event": {
            "$ref": "#/$defs/event"
          }
        },
        "required": [
          "updated",
          "event"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "event_delete",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "True only when the event existed and was removed."
          }
        },
        "required": [
          "deleted"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calendar_ics_import",
      "input": {
        "type": "object",
        "properties": {
          "ics_base64": {
            "type": "string",
            "maxLength": 8388608,
            "description": "Base64-encoded VCALENDAR payload (max ~6 MiB decoded). VEVENTs within [now-1d, now+90d] are upserted keyed by UID — re-importing the same calendar updates in place. RRULEs expand to concrete occurrences (DAILY/WEEKLY/MONTHLY with INTERVAL/COUNT/UNTIL/BYDAY)."
          }
        },
        "required": [
          "ics_base64"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "imported": {
            "type": "integer",
            "description": "Newly created events."
          },
          "updated": {
            "type": "integer",
            "description": "Existing events refreshed by UID."
          },
          "parsed": {
            "type": "integer",
            "description": "VEVENTs found in the payload."
          },
          "window_days": {
            "type": "integer"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "imported",
          "updated",
          "parsed",
          "window_days",
          "event_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calendar_ics_export",
      "input": {
        "type": "object",
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "ics_base64": {
            "type": "string",
            "description": "Base64-encoded VCALENDAR with every stored event (sorted by start_ms)."
          }
        },
        "required": [
          "ics_base64"
        ],
        "additionalProperties": false
      }
    }
  ],
  "$defs": {
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "start_ms": {
          "type": "integer",
          "description": "Unix time in milliseconds (UTC)."
        },
        "end_ms": {
          "type": "integer",
          "description": "Unix time in milliseconds; null when unset."
        },
        "all_day": {
          "type": "boolean"
        },
        "remind_before_ms": {
          "type": "integer",
          "description": "Reminder lead in ms; null = no reminder."
        },
        "reminder_fired": {
          "type": "boolean",
          "description": "True once the reminder was fired (reset when times change)."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ics_uid": {
          "type": "string",
          "description": "UID from an ICS import; re-imports upsert by it. null for hand-created events."
        },
        "created_at_ms": {
          "type": "integer"
        },
        "updated_at_ms": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "start_ms",
        "all_day",
        "reminder_fired",
        "tags",
        "created_at_ms",
        "updated_at_ms"
      ],
      "additionalProperties": false
    }
  },
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "CALENDAR_PLUGIN_DB_TIMEOUT_MS": {
        "type": "integer",
        "minimum": 1,
        "default": 5000,
        "description": "Timeout for each database IPC call."
      },
      "CALENDAR_PLUGIN_SCAN_SECS": {
        "type": "integer",
        "minimum": 0,
        "default": 30,
        "description": "Reminder scan interval in seconds; 0 disables scanning entirely."
      },
      "CALENDAR_PLUGIN_NOTIFY": {
        "type": "boolean",
        "default": true,
        "description": "Also deliver fired reminders through the notify plugin (best-effort)."
      }
    },
    "additionalProperties": true
  }
}
