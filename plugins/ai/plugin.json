{
  "plugin_id": "ai",
  "version": "0.3.0",
  "permissions": ["network", "secrets"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "ai",
  "events": [],
  "files": ["ai", "plugin.json"],
  "actions": [
    {
      "name": "chat_completion",
      "input": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "Named agent profile (model + system prompt) from the ai database. When set, provider/base_url/model/api_key_env are resolved from the stored agent+model and may be omitted."
          },
          "provider": {
            "type": "string",
            "enum": ["anthropic", "openai"],
            "description": "Provider adapter. Required when agent_id is not set (unless the model id is in the ai database)."
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Provider endpoint. Required for openai when neither agent_id nor a stored model id is used; optional for anthropic (defaults to https://api.anthropic.com)."
          },
          "model": {
            "type": "string",
            "description": "Model id — either a stored/discovered model, or an explicit provider model for the legacy path."
          },
          "api_key_env": {
            "type": "string",
            "description": "Name of an env var the ai process reads at call time (never a literal key). Must be on the operator's AI_PLUGIN_ALLOWED_KEY_ENVS allowlist. Required when the model is not resolved from the database."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant", "system"] },
                "content": { "type": "string" }
              },
              "required": ["role", "content"],
              "additionalProperties": false
            },
            "description": "Chat messages. Required, non-empty."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192,
            "default": 1024
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000,
            "default": 30000
          }
        },
        "required": ["messages"],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "content": { "type": "string" },
          "stop_reason": { "type": "string" },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" }
            },
            "additionalProperties": true
          }
        },
        "required": ["content", "stop_reason", "usage"],
        "additionalProperties": false
      }
    },
    {
      "name": "embedding",
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["openai"],
            "description": "Provider adapter. Currently only 'openai' (covers OpenAI, Voyage, Ollama, any OpenAI-compatible embeddings endpoint)."
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Provider endpoint. Required when neither agent_id nor a stored model id is used."
          },
          "model": {
            "type": "string",
            "description": "Embedding model id — e.g. text-embedding-3-small, nomic-embed-text. May be a stored model id."
          },
          "api_key_env": {
            "type": "string",
            "description": "Name of env var holding the key, must be in AI_PLUGIN_ALLOWED_KEY_ENVS allowlist."
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "Text to embed (single input, 1..10000 chars)."
          },
          "agent_id": {
            "type": "string",
            "description": "Optional agent profile whose model is used for embedding (resolves provider/base_url/model/api_key_env from DB)."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000,
            "default": 30000
          }
        },
        "required": ["input"],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "embedding": {
            "type": "array",
            "items": { "type": "number" },
            "description": "L2-normalizable embedding vector."
          },
          "dim": { "type": "integer", "description": "Dimension of the embedding." },
          "model": { "type": "string" },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" }
            }
          }
        },
        "required": ["embedding", "dim", "model", "usage"],
        "additionalProperties": false
      }
    },
    {
      "name": "list_models",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "provider": { "type": "string" },
            "base_url": { "type": "string" },
            "api_key_env": { "type": "string" },
            "is_default": { "type": "boolean" },
            "discovered_at": { "type": ["integer", "null"] },
            "last_seen": { "type": "integer" }
          }
        }
      }
    },
    {
      "name": "list_agents",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "model_id": { "type": "string" },
            "system_prompt": { "type": "string" },
            "goal": { "type": "string" },
            "description": { "type": "string" },
            "is_default": { "type": "boolean" }
          }
        }
      }
    },
    {
      "name": "refresh_models",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "discovered": { "type": "integer" },
          "updated": { "type": "integer" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "name": "usage_stats",
      "input": {
        "type": "object",
        "properties": {}
      },
      "output": {
        "type": "object",
        "properties": {
          "totals": {
            "type": "object",
            "properties": {
              "requests": { "type": "integer" },
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" }
            }
          },
          "by_model": { "type": "array" },
          "by_agent": { "type": "array" }
        }
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "AI_PLUGIN_ALLOWED_KEY_ENVS": {
        "type": "string",
        "description": "Required, default-deny: comma-separated, exact-match allowlist of every env var name a caller's api_key_env may reference. Without it every chat_completion request is rejected."
      },
      "AI_PLUGIN_MODELS": {
        "type": "string",
        "description": "Optional JSON array of hand-declared models: [{\"id\":\"...\",\"provider\":\"openai|anthropic\",\"base_url\":\"...\",\"api_key_env\":\"...\",\"is_default\":true}]. Required for providers without a discovery API (Anthropic)."
      },
      "AI_PLUGIN_AGENTS": {
        "type": "string",
        "description": "Optional JSON array of agent profiles: [{\"id\":\"...\",\"name\":\"...\",\"model_id\":\"...\",\"system_prompt\":\"...\",\"goal\":\"...\",\"description\":\"...\",\"is_default\":true}]."
      },
      "AI_PLUGIN_DISCOVERY": {
        "type": "string",
        "description": "Optional JSON array of sources whose model lists are pulled automatically: [{\"provider\":\"ollama|openai\",\"base_url\":\"...\",\"api_key_env\":\"...\"}]. ollama: GET /api/tags; openai: GET /models."
      }
    },
    "required": ["AI_PLUGIN_ALLOWED_KEY_ENVS"],
    "additionalProperties": true
  }
}