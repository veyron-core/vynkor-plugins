{
  "plugin_id": "gated-write",
  "version": "0.1.0",
  "permissions": ["files_write"],
  "kernel_compatibility_range": {
    "min": "0.1.0",
    "max": "*"
  },
  "binary": "gated-write",
  "events": [],
  "files": ["gated-write", "plugin.json"],
  "actions": [
    {
      "name": "request_write",
      "permission": "files_write",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the data dir (no '..', not absolute)."
          },
          "content": {
            "type": "string",
            "description": "Text to write. Executed only after an approved caller confirms."
          },
          "mode": {
            "type": "string",
            "enum": ["append", "overwrite"],
            "default": "overwrite"
          }
        },
        "required": ["path"],
        "additionalProperties": true
      },
      "output": {
        "type": "object",
        "properties": {
          "pending_id": { "type": "string", "description": "Hand to confirm_write to execute." },
          "action": { "type": "string" },
          "ttl_secs": { "type": "integer" }
        },
        "required": ["pending_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "confirm_write",
      "permission": "files_write",
      "input": {
        "type": "object",
        "properties": {
          "pending_id": {
            "type": "string",
            "description": "pending_id from request_write. Only callers on the confirm allowlist may invoke."
          }
        },
        "required": ["pending_id"],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "description": "Absolute path written." },
          "bytes_written": { "type": "integer" },
          "mode": { "type": "string", "enum": ["append", "overwrite"] }
        },
        "required": ["path", "bytes_written", "mode"],
        "additionalProperties": false
      }
    }
  ],
  "config_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "GATED_WRITE_DATA_DIR": {
        "type": "string",
        "description": "Directory confirmed writes land in. Required."
      },
      "GATED_WRITE_CONFIRM_CALLERS": {
        "type": "string",
        "default": "device.*",
        "description": "Comma-separated plugin ids (or prefix.* globs) allowed to call confirm_write. Everything else can only request."
      }
    },
    "required": ["GATED_WRITE_DATA_DIR"],
    "additionalProperties": true
  }
}
